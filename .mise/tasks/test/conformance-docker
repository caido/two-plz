#!/usr/bin/env bash
#MISE description="Run h2spec against the HTTP/2 server in Linux Docker"
#MISE sources=["Cargo.toml", "Cargo.lock", "src/**/*.rs", "examples/h2spec_server.rs", ".mise/tasks/test/conformance", ".mise/tasks/test/conformance-docker", "ci/h2spec.Dockerfile"]
#MISE outputs={ auto = true }

set -euo pipefail

readonly IMAGE=two-plz-h2spec
readonly WORKSPACE="$(pwd)"

docker build --platform linux/amd64 --file ci/h2spec.Dockerfile --tag "${IMAGE}" .
docker run --rm --platform linux/amd64 \
    --volume "${WORKSPACE}:/workspace" \
    --workdir /workspace \
    "${IMAGE}" \
    mise run test:conformance
